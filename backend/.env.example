# Server
PORT=3000
NODE_ENV=development

# Database — the app auto-detects in this order:
#   1. DATABASE_URL / MYSQL_URL / JAWSDB_URL (mysql:// connection string)
#   2. MYSQLHOST / MYSQLPORT / MYSQLUSER / MYSQLPASSWORD / MYSQLDATABASE (Railway MySQL plugin vars)
#   3. DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME (manual vars)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Kamanzidjazili@123
DB_NAME=noor_academy

# JWT
JWT_SECRET=change_this_to_a_random_secret_string
JWT_EXPIRES_IN=7d

# Admin account (auto-created on first start if it doesn't exist)
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@nooracademy.com
ADMIN_USERNAME=admin

# File Uploads
UPLOAD_DIR=./uploads
MAX_VIDEO_SIZE_MB=500
MAX_IMAGE_SIZE_MB=5

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5500
